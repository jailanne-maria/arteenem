rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return logado() && request.auth.token.email in [
        'jailanne.almeida@gmail.com',
        'jailanne.maria@gmail.com'
      ];
    }

    // ---- Perfis ----
    match /usuarios/{uid} {
      allow get: if logado();
      allow list: if ehAdmin();
      allow create: if logado() && request.auth.uid == uid;
      allow update: if logado() && (request.auth.uid == uid || ehAdmin());
      allow delete: if ehAdmin();
    }

    // ---- Turmas e membros ----
    match /turmas/{codigo} {
      allow read, write: if logado();
      match /membros/{uid} {
        allow read, write: if logado();
      }
    }

    // ---- Mensagens diretas (falar com a professora) ----
    match /suporte/{uid} {
      allow read, write: if logado() && (request.auth.uid == uid || ehAdmin());
      match /mensagens/{id} {
        allow read, write: if logado() && (request.auth.uid == uid || ehAdmin());
      }
    }

    // ---- Chats (o autor apaga a própria; admin apaga qualquer uma) ----
    match /mensagens/{id} {
      allow read: if logado();
      allow create: if logado();
      allow delete: if logado() && (resource.data.uid == request.auth.uid || ehAdmin());
    }
    match /mensagensTurma/{id} {
      allow read: if logado();
      allow create: if logado();
      allow delete: if logado() && (resource.data.uid == request.auth.uid || ehAdmin());
    }

    // ---- Novidades (só o admin publica) ----
    match /novidades/{id} {
      allow read: if logado();
      allow write: if ehAdmin();
    }

    // ---- Revisões (só o professor dono edita/apaga) ----
    match /revisoes/{id} {
      allow read: if logado();
      allow create: if logado();
      allow update, delete: if logado() && (resource.data.professorId == request.auth.uid || ehAdmin());
    }

    // ---- Atividades (só o professor dono edita/apaga) ----
    match /atividades/{id} {
      allow read: if logado();
      allow create: if logado();
      allow update, delete: if logado() && (resource.data.professorId == request.auth.uid || ehAdmin());
    }

    // ---- Resto do app ----
    match /resultados/{id} { allow read, write: if logado(); }
    match /depoimentos/{id} { allow read, write: if logado(); }
    match /perguntas/{id} { allow read, write: if logado(); }
    match /duelos/{id} { allow read, write: if logado(); }
    match /respostasAtividade/{id} { allow read, write: if logado(); }
    match /respostasQuiz/{id} { allow read, write: if logado(); }
  }
}
